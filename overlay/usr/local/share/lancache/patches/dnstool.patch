From b9efe3a7ac74fa53d0de9857dd04ea95fd9bb4e4 Mon Sep 17 00:00:00 2001
From: mediumraredev <167935824+mediumraredev@users.noreply.github.com>
Date: Tue, 14 Apr 2026 13:26:56 +1000
Subject: [PATCH] Modified paths in /cmd/const.go from /etc to /usr/local/etc

---
 cmd/const.go | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/cmd/const.go b/cmd/const.go
index fe303ba..a5f0267 100644
--- a/cmd/const.go
+++ b/cmd/const.go
@@ -7,9 +7,9 @@ const (
 	domainsPath = "/opt/cache-domains"
 	cacheDomain = "cache_domains.json"
 
-	cacheConf  = "/etc/bind/cache.conf"
-	namedConf  = "/etc/bind/named.conf.options"
-	zonePath   = "/etc/bind/cache/"
+	cacheConf  = "/usr/local/etc/bind/cache.conf"
+	namedConf  = "/usr/local/etc/bind/named.conf.options"
+	zonePath   = "/usr/local/etc/bind/cache/"
 	rpzZone    = zonePath + "rpz.db"
 	customZone = zonePath + "custom.db"
 
@@ -40,11 +40,11 @@ Make sure you are using a monolithic cache or load balancer at %s
 
 	cacheConfTemplate = `	zone "cache.lancache.net" {
 		type master;
-		file "/etc/bind/cache/cache.lancache.net.db";
+		file "/usr/local/etc/bind/cache/cache.lancache.net.db";
 	};
 	zone "rpz" {
 		type master;
-		file "/etc/bind/cache/rpz.db";
+		file "/usr/local/etc/bind/cache/rpz.db";
 		allow-query { none; };
 	};`
 

