From f777bac48063f594a2e66396ebc899b46a3dccfe Mon Sep 17 00:00:00 2001
From: mediumraredev <167935824+mediumraredev@users.noreply.github.com>
Date: Tue, 14 Apr 2026 14:12:34 +1000
Subject: [PATCH 5/6] Adjustments to nginx.conf to suit FreeBSD

---
 overlay/etc/nginx/nginx.conf | 35 ++++++++++++++++++++++++++---------
 1 file changed, 26 insertions(+), 9 deletions(-)

diff --git a/overlay/etc/nginx/nginx.conf b/overlay/etc/nginx/nginx.conf
index 4579c16..bd35292 100644
--- a/overlay/etc/nginx/nginx.conf
+++ b/overlay/etc/nginx/nginx.conf
@@ -1,7 +1,7 @@
 user www-data;
 worker_processes auto;
-pid /run/nginx.pid;
-include /etc/nginx/modules-enabled/*.conf;
+pid /var/run/nginx.pid;
+include /usr/local/etc/nginx/modules-enabled/*.conf;
 
 events {
   worker_connections 768;
@@ -20,13 +20,13 @@ http {
   keepalive_timeout 65;
   types_hash_max_size 2048;
 
-  include /etc/nginx/mime.types;
-  default_type application/octet-stream;
-
   ##
   # SSL Settings
   ##
 
+  include /usr/local/etc/nginx/mime.types;
+  default_type application/octet-stream;
+
   ssl_protocols TLSv1 TLSv1.1 TLSv1.2; # Dropping SSLv3, ref: POODLE
   ssl_prefer_server_ciphers on;
 
@@ -41,12 +41,29 @@ http {
   # Virtual Host Configs
   ##
 
-  include /etc/nginx/conf.d/*.conf;
-  include /etc/nginx/sites-enabled/*;
+  ##
+  # Gzip Settings
+  ##
+
+  #gzip on;
+
+  # gzip_vary on;
+  # gzip_proxied any;
+  # gzip_comp_level 6;
+  # gzip_buffers 16 8k;
+  # gzip_http_version 1.1;
+  # gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
+
+  ##
+  # Virtual Host Configs
+  ##
+
+  include /usr/local/etc/nginx/conf.d/*.conf;
+  include /usr/local/etc/nginx/sites-enabled/*;
 }
 
 
 stream {
-  include /etc/nginx/stream.d/*.conf;
-  include /etc/nginx/stream-enabled/*;
+  include /usr/local/etc/nginx/stream.d/*.conf;
+  include /usr/local/etc/nginx/stream-enabled/*;
 }
